# Environment
APP_ENV=development
DEBUG=false

# Runtime secrets
OPENAI_API_KEY=
JWT_SECRET=replace-with-a-long-random-secret-change-me-now

# LLM
OPENAI_MODEL=deepseek-chat
OPENAI_BASE_URL=https://api.deepseek.com
LLM_MAX_CONCURRENCY=10

# PostgreSQL
POSTGRES_USER=ai_agent
POSTGRES_PASSWORD=ai_agent
POSTGRES_DB=ai_job_agent
DATABASE_URL=postgresql://ai_agent:ai_agent@localhost:5432/ai_job_agent
POSTGRES_IMAGE_VERSION=16-alpine

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_IMAGE_VERSION=7-alpine

# Vector and RAG
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
VECTOR_STORE=chroma
QDRANT_URL=http://localhost:6333
QDRANT_IMAGE_VERSION=v1.12.6
RERANK_ENABLED=true
CANDIDATE_TOP_K=20
HYBRID_ALPHA=0.5
HF_ENDPOINT=https://hf-mirror.com
HF_HOME=/app/.cache/huggingface

# Auth
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Local published ports
BACKEND_PORT=8000
FRONTEND_PORT=5173

# Observability
OTEL_ENABLED=true
OTEL_SERVICE_NAME=ai-job-agent
OTEL_EXPORTER_OTLP_ENDPOINT=

HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1

# Cost, cache and fallback
LLM_COST_BUDGET_USD=0
LLM_CACHE_ENABLED=false
LLM_CACHE_TTL_SECONDS=300
LLM_FALLBACK_MODELS_CSV=deepseek-reasoner

# Demo auth
DEMO_USERNAME=demo
DEMO_PASSWORD=Demo@2026
ALLOW_REGISTRATION=false

# Quota
GUEST_DAILY_QUESTIONS=5
GUEST_DAILY_TOKENS=20000
AUTHENTICATED_DAILY_QUESTIONS=0
AUTHENTICATED_DAILY_TOKENS=0
QUOTA_TIMEZONE=Asia/Shanghai